<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:padding="16dp">

    <!-- 순서 번호 -->

    <!-- 관광지 이미지 -->
    <TextView
        android:id="@+id/textOrder"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/route_number"
        android:gravity="center"
        android:text="1"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imagePlace"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/sample_image"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/textOrder" />

    <!-- 관광지 이름 -->
    <TextView
        android:id="@+id/textPlaceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="마나가하 섬"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/imagePlace"
        app:layout_constraintStart_toEndOf="@id/imagePlace"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 시간대 -->
    <TextView
        android:id="@+id/textTimeRange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="10:00 ~ 12:00"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/textPlaceName"
        app:layout_constraintStart_toStartOf="@id/textPlaceName"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이동수단 설명 -->
    <TextView
        android:id="@+id/textTravelTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="차량 15분"
        android:textSize="12sp"
        android:textColor="#888888"
        app:layout_constraintTop_toBottomOf="@id/textTimeRange"
        app:layout_constraintStart_toStartOf="@id/textPlaceName"
        app:layout_constraintBottom_toBottomOf="@id/imagePlace"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>